<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>RemotePad</AssemblyName>
    <Product>Remote Pad</Product>
    <Company>Lamacchia Solutions</Company>
    <Copyright>Copyright © 2026 Lamacchia Solutions</Copyright>
    <Description>Keyboard and mouse controller for Xbox and PS5 Remote Play</Description>
    <Version>1.2.0</Version>
    <ApplicationIcon Condition="Exists('RemotePad.ico')">RemotePad.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" GeneratePathProperty="true" />
    <Reference Include="System.Web.Extensions" />
    <Content Include="..\ps5\compose.yaml;..\ps5\Start PS5 Player.cmd" Link="PS5\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\docs\PS5.md" Link="Documentation\PS5.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\app\*" Link="app\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE;..\EULA.md;..\PRIVACY.md;..\SUPPORT.md" Link="Documentation\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt" Link="Documentation\WebView2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\NOTICE.txt" Link="Documentation\WebView2-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
